# vLLM-Dashboard 环境配置
API_HOST=0.0.0.0
API_PORT=5174

# 可选：HuggingFace 镜像。留空则直连 huggingface.co。
# 国内网络建议保留 hf-mirror.com；模型下载与 CLI 命令仅在此值非空时注入。
HF_ENDPOINT=https://hf-mirror.com

# 可选：pip 源镜像。留空则直连 pypi.org。
# 国内网络建议保留阿里云镜像；pip 安装仅在此值非空时使用。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 可选：API 访问密钥（亦可用别名 API_KEY）。设置后所有 API 需携带 X-API-Key 头，
# 前端首次访问会弹窗索取密钥；留空（默认）则开放访问。
# VLLM_DASHBOARD_API_KEY=

# ---- 以下为高级选项（settings.py / main.py 实际读取，均有默认值，按需取消注释）----

# SSH 主机密钥严格模式（默认 true：按 known_hosts 校验，首连自动记录；false 则自动接受）
# VLLM_DASHBOARD_SSH_STRICT_HOST_KEY=true

# 远程 venv 的 Python 路径（可选，默认空 = 不注入）
# VLLM_PYTHON_PATH=

# API HTTP 客户端超时（秒，默认 10）
# API_TIMEOUT=10

# 基准测试远端执行超时（秒，默认 60）
# BENCHMARK_TIMEOUT=60

# 对话代理超时（秒，默认 300；语义为相邻两次读取的最大间隔，见 settings.py 注释）
# CHAT_TIMEOUT=300

# 模型状态同步的远端探测超时（秒，默认 5）
# STATUS_SYNC_TIMEOUT=5

# SSH 单命令超时（秒，默认 10；连接超时为其一半）
# SSH_CMD_TIMEOUT=10

# 硬件采集（nvidia-smi/sysinfo）远端读取超时（秒，默认 25；须小于前端 30s axios 超时）
# HARDWARE_PROBE_TIMEOUT=25

# 允许所有 CORS 来源（默认关；仅完全可信网络使用，见 main.py 警告）
# VLLM_DASHBOARD_CORS_ALL=

# 前端静态目录（默认 ./static）
# STATIC_DIR=

# 日志级别（默认 INFO）
# LOG_LEVEL=INFO
