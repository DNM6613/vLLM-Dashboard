# vLLM-Dashboard 环境配置
API_HOST=0.0.0.0
API_PORT=5174

# 可选：HuggingFace 镜像。留空则直连 huggingface.co。
# 国内网络建议保留 hf-mirror.com；模型下载与 CLI 命令仅在此值非空时注入。
HF_ENDPOINT=https://hf-mirror.com

# 可选：pip 源镜像。留空则直连 pypi.org。
# 国内网络建议保留阿里云镜像；pip 安装仅在此值非空时使用。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 可选：API 访问密钥（亦可用别名 API_KEY）。设置后所有 API 需携带 X-API-Key 头，
# 前端首次访问会弹窗索取密钥；留空（默认）则开放访问。
# VLLM_DASHBOARD_API_KEY=
